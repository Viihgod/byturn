{
  "name": "byturn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server/start.mjs",
    "setup": "node server/setup.mjs",
    "setup:demo": "node server/setup.mjs --demo",
    "test:server": "node --test server/app.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "node scripts/check.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "release": "node scripts/release.mjs",
    "test:tooling": "node --test scripts/workflow.test.mjs scripts/package.test.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "docs:build": "node scripts/build-guide-docs.mjs",
    "package:design": "node scripts/build-tokens.mjs && node scripts/build-guide-docs.mjs && node scripts/package-design-system.mjs",
    "review:build": "node scripts/build-review.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
